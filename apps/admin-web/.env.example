# Admin Web — environment variables
# Copy to apps/admin-web/.env.local and fill in real values. Never commit secrets.
# Reference: turvo_phase1_spec.md section 39.

# Supabase project (same project as the backend).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=anon-key

# Node API base URL. Defaults to /api/v1 (same origin via the Vite proxy in
# development, or a reverse proxy in production).
VITE_API_BASE_URL=/api/v1
