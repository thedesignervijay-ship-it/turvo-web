# Turvo Phase 1 backend configuration.
# Copy to .env and fill in real values. Never commit secrets.

NODE_ENV=development
PORT=4000

# Supabase project config.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Used by the backend to verify Supabase Auth access tokens (HS256).
# This is the project JWT secret (Settings > API > JWT Settings > JWT Secret).
SUPABASE_JWT_SECRET=your-super-secret-jwt-secret

# Direct PostgreSQL connection used by the Node backend.
# For production Supabase use the connection string with sslmode=require,
# or set NODE_ENV=production to enable SSL automatically.
DATABASE_URL=postgresql://postgres:password@localhost:5432/turvo

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
