# Turvo - Environment Configuration
# Copy to .env and fill in real values. Never commit .env files.
# Reference: turvo_phase1_spec.md section 39.

# --- Node / runtime ---
NODE_ENV=development
PORT=4000

# --- Supabase ---
# Project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=
# Public anon key. Safe for the browser; must not be confused with the service role key.
SUPABASE_ANON_KEY=
# Backend-only secret. NEVER expose to the browser or frontend code.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used by the backend to verify Supabase Auth access tokens (HS256).
# Found in Supabase Dashboard > Settings > API > JWT Settings > JWT Secret.
SUPABASE_JWT_SECRET=
# Direct Postgres connection string (backend only).
DATABASE_URL=

# --- API ---
# Comma-separated list of allowed origins for the admin and owner web apps.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
